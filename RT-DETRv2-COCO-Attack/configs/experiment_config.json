{
  "experiment_name": "Hyper-YOLO-to-RT-DETRv2-S Transfer Attack",
  "attack_type": "transfer_attack",
  "model": "RT-DETRv2-S",
  "model_family": "Real-Time DEtection TRansformer (RT-DETRv2)",
  "backbone": "PResNet-18 / R18vd",
  "config": "third_party/RT-DETR/rtdetrv2_pytorch/configs/rtdetrv2/rtdetrv2_r18vd_120e_coco.yml",
  "checkpoint": "weights/rtdetrv2_r18vd_120e_coco_rerun_48.1.pth",
  "checkpoint_url": "https://github.com/lyuwenyu/storage/releases/download/v0.2/rtdetrv2_r18vd_120e_coco_rerun_48.1.pth",
  "official_repo": "https://github.com/lyuwenyu/RT-DETR",
  "paper": "https://arxiv.org/abs/2407.17140",
  "input_size": [640, 640],
  "dataset": "COCO 2017",
  "target_classes": ["person", "car"],
  "confidence_threshold": 0.25,
  "target_match_iou_threshold": 0.5,
  "matching_rule": "same predicted class as selected target_class AND highest IoU among same-class detections; valid if IoU >= 0.50",
  "eligible_target_rule": "eligible iff clean image has a valid target match",
  "attack_success_definition": "eligible AND patched image does NOT have a valid target match",
  "asr_formula": "successful_attacks / eligible_targets * 100",
  "source_project": "D:\\project CS\\Adversarial-Patch-Experiment",
  "source_data_location": "D:\\project CS\\RT-DETRv2-COCO-Attack\\source_data",
  "attack_ids": ["attack_01", "attack_02", "attack_03", "attack_04", "attack_05"],
  "do_not_regenerate_patches": true,
  "fine_tune": false
}
